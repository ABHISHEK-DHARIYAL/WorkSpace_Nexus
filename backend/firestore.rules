rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- 0. Startup Check ---
    match /_startup_check_/{docId} {
      allow read: if true;
    }

    // --- Global Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    // --- 1. Users Collection ---
    match /users/{email} {
      allow read: if isSignedIn() && (request.auth.token.email == email || request.auth.token.email == 'admin@workspace.com');
      allow write: if isSignedIn() && (request.auth.token.email == email || request.auth.token.email == 'admin@workspace.com');
    }

    // --- 2. Contents (CMS Pages) ---
    match /contents/{contentId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email == 'admin@workspace.com';
    }

    // --- 3. Workspaces ---
    match /workspaces/{workspaceId} {
      allow read: if isSignedIn() && (
        resource.data.owner == request.auth.uid || 
        resource.data.owner == request.auth.token.email || 
        workspaceId.startsWith('main-') || 
        request.auth.token.email == 'admin@workspace.com'
      );
      allow create: if isSignedIn() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.owner == request.auth.uid || 
        resource.data.owner == request.auth.token.email || 
        request.auth.token.email == 'admin@workspace.com'
      );
    }

    // --- 4. Listings / Documents ---
    match /listings/{listingId} {
      allow read: if resource.data.visibility == 'public' || (
        isSignedIn() && (
          resource.data.owner == request.auth.uid || 
          resource.data.owner == request.auth.token.email || 
          request.auth.token.email == 'admin@workspace.com'
        )
      );
      allow create: if isSignedIn() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.owner == request.auth.uid || 
        resource.data.owner == request.auth.token.email || 
        request.auth.token.email == 'admin@workspace.com'
      );
    }

    // --- 5. Pages of Document Listings ---
    match /pages/{pageId} {
      allow read: if get(/databases/$(database)/documents/listings/$(resource.data.listingId)).data.visibility == 'public' || 
                   (isSignedIn() && (
                      get(/databases/$(database)/documents/listings/$(resource.data.listingId)).data.owner == request.auth.uid || 
                      get(/databases/$(database)/documents/listings/$(resource.data.listingId)).data.owner == request.auth.token.email || 
                      request.auth.token.email == 'admin@workspace.com'
                    ));
      allow create: if isSignedIn() && (
        get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.owner == request.auth.uid || 
        request.auth.token.email == 'admin@workspace.com'
      );
      allow update, delete: if isSignedIn() && (
        get(/databases/$(database)/documents/listings/$(resource.data.listingId)).data.owner == request.auth.uid || 
        request.auth.token.email == 'admin@workspace.com'
      );
    }

    // --- 6. Highlights ---
    match /highlights/{highlightId} {
      allow read: if get(/databases/$(database)/documents/listings/$(resource.data.listingId)).data.visibility == 'public' || 
                   (isSignedIn() && (
                      get(/databases/$(database)/documents/listings/$(resource.data.listingId)).data.owner == request.auth.uid || 
                      get(/databases/$(database)/documents/listings/$(resource.data.listingId)).data.owner == request.auth.token.email || 
                      request.auth.token.email == 'admin@workspace.com'
                    ));
      allow create: if isSignedIn() && (
        get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.visibility == 'public' || 
        get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.owner == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.email == 'admin@workspace.com');
    }

    // --- 7. Annotations ---
    match /annotations/{annotationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.email == 'admin@workspace.com');
    }

    // --- 8. Public Interaction Collections ---
    match /follows/{followId} {
      allow read, write: if isSignedIn();
    }
    match /favorites/{favId} {
      allow read, write: if isSignedIn();
    }
    match /bookmarks/{bkId} {
      allow read, write: if isSignedIn();
    }
    match /drafts/{draftId} {
      allow read, write: if isSignedIn();
    }
    match /page_versions/{verId} {
      allow read, write: if isSignedIn();
    }
    match /doc_indices/{indexId} {
      allow read, write: if isSignedIn();
    }
    match /doc_pages/{pageId} {
      allow read, write: if isSignedIn();
    }
    match /admin_audit_logs/{logId} {
      allow read: if isSignedIn() && request.auth.token.email == 'admin@workspace.com';
      allow create: if isSignedIn();
    }

    // --- 9. Workspace Hub and Document Nexus Independent Collections ---
    match /workspaceHubWorkspaces/{workspaceId} {
      allow read, write: if isSignedIn();
    }
    match /workspaceHubProjects/{projectId} {
      allow read, write: if isSignedIn();
    }
    match /documentNexusWorkspaces/{workspaceId} {
      allow read, write: if isSignedIn();
    }
    match /documentNexusDocuments/{documentId} {
      allow read, write: if isSignedIn();
    }
  }
}
